{
  "name": "My Internship Notebook",
  "short_name": "Notebook",
  "description": "A private notebook for internship applications, interviews, deadlines, and offers.",
  "id": "./",
  "start_url": "./#/today",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#f3eee4",
  "theme_color": "#1f3447",
  "categories": ["productivity", "education"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New application", "short_name": "New", "url": "./#/new", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Board", "url": "./#/board", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
