{
  "manifest_version": 3,
  "name": "My Internship Notebook: Save Jobs",
  "short_name": "Save to Notebook",
  "version": "1.0.0",
  "description": "Save the job posting you're looking at to My Internship Notebook, with the company, role, location, and closing date filled in.",
  "homepage_url": "https://internshipnotebook.app/",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "Save this job to My Internship Notebook",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save the job in this tab"
    }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "minimum_chrome_version": "102",
  "browser_specific_settings": {
    "gecko": {
      "id": "save-jobs@internshipnotebook.app",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
